# Settings for deploy/docker-compose.yml. Copy to deploy/.env, which git ignores, and fill in the secrets.

# The database's password: anything long and random, such as the output of `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# Signs the access tokens: 32 characters or more, random (`openssl rand -hex 32`). Changing it logs
# everyone out.
JWT_SECRET=

# Where the app is served on this machine.
WEB_PORT=8000

# Logins and signups each address may make in a minute.
AUTH_REQUESTS_PER_MINUTE=10

# The demo user that `make seed` creates. Meant to be shared: the login page offers it, with no password.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=try-the-demo
