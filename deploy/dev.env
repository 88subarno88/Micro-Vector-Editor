# Settings for running the server against deploy/docker-compose.dev.yml. Not for production.
# Load with: set -a; source deploy/dev.env; set +a
PORT=8080
DATABASE_URL=postgres://vec:vec@127.0.0.1:55432/vec?sslmode=disable
REDIS_URL=redis://127.0.0.1:56379/0
JWT_SECRET=dev-only-secret-do-not-use-in-production
# Where vec_worker saves exported files, relative to the repository root
EXPORT_DIR=build/exports

# For dbmate
DBMATE_MIGRATIONS_DIR=server/migrations
DBMATE_NO_DUMP_SCHEMA=true

# For the tests. They empty these between tests, so they must not be the databases above.
# Create and migrate the test database with: dbmate -e TEST_DATABASE_URL up
TEST_DATABASE_URL=postgres://vec:vec@127.0.0.1:55432/vec_test?sslmode=disable
TEST_REDIS_URL=redis://127.0.0.1:56379/1
