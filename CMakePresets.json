{
  "version": 3,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Debug build with vcpkg",
      "binaryDir": "${sourceDir}/build/dev",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "server",
      "displayName": "Backend server and core tests",
      "binaryDir": "${sourceDir}/build/server",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_MANIFEST_FEATURES": "server",
        "VCPKG_INSTALLED_DIR": "$env{HOME}/.cache/micro-vector-editor/vcpkg_installed",
        "BUILD_DESKTOP": "OFF",
        "BUILD_SERVER": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "Core and tests with ASan and UBSan",
      "binaryDir": "${sourceDir}/build/asan",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "BUILD_DESKTOP": "OFF"
      }
    },
    {
      "name": "tsan",
      "displayName": "Server and tests with ThreadSanitizer, dependencies included",
      "binaryDir": "${sourceDir}/build/tsan",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "VCPKG_MANIFEST_FEATURES": "server",
        "VCPKG_INSTALLED_DIR": "$env{HOME}/.cache/micro-vector-editor/vcpkg_installed",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "VCPKG_TARGET_TRIPLET": "x64-linux-tsan",
        "BUILD_DESKTOP": "OFF",
        "BUILD_SERVER": "ON"
      }
    },
    {
      "name": "wasm",
      "displayName": "Core compiled to WebAssembly with Emscripten (source emsdk_env.sh first)",
      "binaryDir": "${sourceDir}/build/wasm",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "wasm32-emscripten",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "VCPKG_INSTALLED_DIR": "$env{HOME}/.cache/micro-vector-editor/vcpkg_installed",
        "BUILD_DESKTOP": "OFF",
        "BUILD_CLI": "OFF",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer targets with ASan and UBSan",
      "binaryDir": "${sourceDir}/build/fuzz",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-fsanitize=fuzzer-no-link,address,undefined -fno-sanitize-recover=undefined",
        "BUILD_DESKTOP": "OFF",
        "BUILD_CLI": "OFF",
        "BUILD_TESTS": "OFF",
        "BUILD_FUZZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "server",
      "configurePreset": "server"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "wasm",
      "configurePreset": "wasm"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "server",
      "configurePreset": "server",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true },
      "environment": {
        "TSAN_OPTIONS": "suppressions='${sourceDir}/server/tests/tsan.supp' second_deadlock_stack=1"
      }
    }
  ]
}
